{
  "name": "jumplinks-editorial-workflow",
  "version": "2.4.3",
  "description": "Jumplinks Flow - Editorial Review & Content Approval Workflow",
  "scripts": {
    "test:php": "php vendor/bin/phpunit -c phpunit.xml.dist",
    "test:seed": "bash scripts/test-e2e-seed.sh",
    "test:free": "bash scripts/test-free.sh",
    "test:free:ui": "bash scripts/test-free.sh --ui",
    "test:free:debug": "bash scripts/test-free.sh --debug",
    "test:free:headed": "bash scripts/test-free.sh --headed",
    "test:pro": "bash scripts/test-pro.sh",
    "test:pro:ui": "bash scripts/test-pro.sh --ui",
    "test:pro:debug": "bash scripts/test-pro.sh --debug",
    "test:pro:headed": "bash scripts/test-pro.sh --headed",
    "test:env:gutenberg": "bash scripts/test-env.sh gutenberg free",
    "test:env:gutenberg:pro": "bash scripts/test-env.sh gutenberg pro",
    "test:env:elementor": "bash scripts/test-env.sh elementor free",
    "test:env:bricks": "bash scripts/test-env.sh bricks free",
    "test:env:avada": "bash scripts/test-env.sh avada free",
    "test:env:breakdance": "bash scripts/test-env.sh breakdance free",
    "test:env:beaver": "bash scripts/test-env.sh beaver free",
    "test:env:divi": "bash scripts/test-env.sh divi free",
    "test:env:oxygen": "bash scripts/test-env.sh oxygen free",
    "test:free:all": "bash scripts/test-all-envs.sh free",
    "test:pro:all": "bash scripts/test-env.sh gutenberg pro",
    "test:free:all:sequential": "for e in gutenberg elementor bricks avada breakdance beaver divi oxygen; do bash scripts/test-env.sh $e free || exit 1; done",
    "test:free:all:parallel": "bash scripts/test-all-envs.sh free",
    "test:env:all": "bash scripts/test-all-envs.sh free && bash scripts/test-env.sh gutenberg pro",
    "lando:start": "bash scripts/lando-all.sh start",
    "lando:stop": "bash scripts/lando-all.sh stop",
    "lando:restart": "bash scripts/lando-all.sh restart",
    "lando:rebuild": "bash scripts/lando-all.sh rebuild -y",
    "build:readable": "NODE_ENV=development webpack --config webpack.config.js",
    "build:minified": "NODE_ENV=production webpack --config webpack.config.js",
    "build": "npm run build:readable && npm run build:minified",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src/",
    "make-pot": "php scripts/make-pot.php",
    "make-pot-pro": "php scripts/make-pot.php --pro",
    "compile-translations": "python3 scripts/po-to-l10n-php.py",
    "compile-translations-pro": "python3 scripts/merge-translations.py && python3 scripts/json-to-po.py --pro && python3 scripts/po-to-l10n-php.py --pro",
    "check:dist": "bash scripts/plugin-check.sh free",
    "check:dist:pro": "bash scripts/plugin-check.sh pro",
    "package": "npm run build && npm run make-pot && npm run compile-translations && python3 scripts/make-dist-zip.py && npm run check:dist",
    "package:pro": "npm run build && npm run make-pot-pro && npm run compile-translations-pro && python3 scripts/make-pro-zip.py && npm run check:dist:pro",
    "package:jumplinks": "npm run build && npm run make-pot-pro && npm run compile-translations-pro && python3 scripts/make-jumplinks-zip.py",
    "release": "python3 scripts/release-svn.py",
    "release:commit": "python3 scripts/release-svn.py --commit",
    "release:github": "python3 scripts/release-github.py"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.22.2",
    "@tiptap/extension-link": "^3.22.2",
    "@tiptap/extension-mention": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-subscript": "^3.22.2",
    "@tiptap/extension-superscript": "^3.22.2",
    "@tiptap/extension-text-align": "^3.22.2",
    "@tiptap/extension-underline": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.39",
    "@wordpress/e2e-test-utils-playwright": "^1.43.0",
    "@wordpress/icons": "^12.1.0",
    "@wordpress/scripts": "^30.0.0",
    "dotenv": "^17.4.2",
    "sass": "^1.99.0",
    "typescript": "^6.0.2"
  }
}
